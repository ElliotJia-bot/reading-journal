rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /{collection}/{document} {
        allow read: if request.auth != null && request.auth.uid == uid
          && collection in ['books', 'sessions', 'insights'];
        allow write: if false;
      }
    }
    // Validated writes go through the backend, which verifies the Firebase ID
    // token and derives the user path from that token, never from client input.
    match /{document=**} { allow read, write: if false; }
  }
}
